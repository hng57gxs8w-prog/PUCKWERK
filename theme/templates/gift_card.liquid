{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Geschenkkarte – {{ shop.name }}</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="password">
      <div class="password__inner giftcard">
        <span class="password__logo">{% render 'logo', variant: 'stacked' %}</span>
        <p class="kicker">Deine Geschenkkarte</p>
        <p class="display giftcard__amount">{{ gift_card.initial_value | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p>Restguthaben: {{ gift_card.balance | money }}</p>
        {%- endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="form-error">Diese Geschenkkarte ist {% if gift_card.expired %}abgelaufen{% else %}deaktiviert{% endif %}.</p>
        {%- endif -%}
        <div class="giftcard__code">
          <input type="text" readonly value="{{ gift_card.code | format_code }}" aria-label="Geschenkkarten-Code" onclick="this.select()">
        </div>
        {%- if gift_card.expires_on -%}<p>Gültig bis {{ gift_card.expires_on | date: '%d.%m.%Y' }}</p>{%- endif -%}
        <div id="QrCode" class="giftcard__qr"></div>
        <div class="btn-row">
          <a href="{{ shop.url }}" class="btn btn--accent">Jetzt einlösen</a>
          <button type="button" class="btn btn--outline-light" onclick="window.print()">Drucken</button>
        </div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Zu Apple Wallet hinzufügen" loading="lazy"></a>
        {%- endif -%}
      </div>
    </main>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    <script>
      window.addEventListener('DOMContentLoaded', function () {
        if (window.QRCode) new QRCode(document.getElementById('QrCode'), { text: {{ gift_card.qr_identifier | json }}, width: 120, height: 120 });
      });
    </script>
  </body>
</html>

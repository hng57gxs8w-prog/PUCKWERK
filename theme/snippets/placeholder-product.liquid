{%- comment -%}
  Platzhalterkarte: erscheint nur, solange in der gewählten Kollektion noch keine
  Produkte veröffentlicht sind. Zeigt Shopifys neutrales Platzhalter-Symbol statt
  eines erfundenen Produkts.
  Parameter: index
{%- endcomment -%}
{%- assign n = index | modulo: 6 | plus: 1 -%}
<article class="card card--placeholder">
  <span class="card__media ratio--square">{{ 'product-' | append: n | placeholder_svg_tag: 'card__img placeholder' }}</span>
  <div class="card__info">
    <h3 class="card__title">Produktname</h3>
    <div class="price"><span class="price__current">0,00 €</span></div>
  </div>
</article>

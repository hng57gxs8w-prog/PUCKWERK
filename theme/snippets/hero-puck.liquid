      <radialGradient id="pa-bed-{{ uid }}" cx="40%" cy="36%" r="72%">
        <stop offset="0" stop-color="#7C5338"/>
        <stop offset=".42" stop-color="#523523"/>
        <stop offset=".82" stop-color="#2F1E14"/>
        <stop offset="1" stop-color="#21150E"/>
      </radialGradient>
      <linearGradient id="pa-steel-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#F1ECE5"/>
        <stop offset=".2" stop-color="#9F9891"/>
        <stop offset=".42" stop-color="#F7F2EB"/>
        <stop offset=".6" stop-color="#7B746E"/>
        <stop offset=".8" stop-color="#DCD6CF"/>
        <stop offset="1" stop-color="#8A837D"/>
      </linearGradient>
      <radialGradient id="pa-sheen-{{ uid }}" cx="28%" cy="22%" r="62%">
        <stop offset="0" stop-color="#FFE2BF" stop-opacity=".42"/>
        <stop offset=".45" stop-color="#FFE2BF" stop-opacity=".08"/>
        <stop offset="1" stop-color="#FFE2BF" stop-opacity="0"/>
      </radialGradient>
      <pattern id="pa-grain-{{ uid }}" width="128" height="128" patternUnits="userSpaceOnUse">
        <image href="{{ 'grain.png' | asset_url }}" width="128" height="128"/>
      </pattern>
      <clipPath id="pa-clip-{{ uid }}"><circle cx="300" cy="300" r="209"/></clipPath>
      <filter id="pa-blur-{{ uid }}" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="22"/></filter>
    </defs>

    <circle class="pa-shadow" cx="318" cy="334" r="258" filter="url(#pa-blur-{{ uid }})"/>


{%- comment -%}
  Produktkarte nach CI: Bild rund 20 px auf Crema, Text frei auf der Grundfläche.
  Parameter: product
{%- endcomment -%}
{%- liquid
  assign ratio_class = 'ratio--' | append: settings.card_ratio
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<article class="card">
  <a href="{{ product.url }}" class="card__media {{ ratio_class }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img', alt: '' }}
      {%- if settings.card_hover_image and product.media[1] -%}
        {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img card__img--hover', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__img placeholder' }}
    {%- endif -%}
    <span class="card__badges">
      {%- if on_sale -%}<span class="badge">Reduziert</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge badge--muted">Ausverkauft</span>{%- endunless -%}
    </span>
    <span class="card__cta">{% render 'icon', name: 'arrow' %}</span>
  </a>
  <div class="card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <p class="card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if settings.card_show_type and product.type != blank -%}
      <p class="card__meta">{{ product.type }}</p>
    {%- endif -%}
    {% render 'price', product: product %}
  </div>
</article>

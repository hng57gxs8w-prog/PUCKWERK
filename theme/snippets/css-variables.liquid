{%- comment -%}
  PUCKWERK – Design-Tokens. Schlichtes, helles Theme: Kopf- und Fußzeile dunkel mit
  weißem Logo, der restliche Inhalt hell, damit die Produkte im Vordergrund stehen.
  Schriften lokal im Theme: Space Grotesk (c) The Space Grotesk Project Authors,
  Inter (c) The Inter Project Authors – SIL Open Font License 1.1 (https://openfontlicense.org).
{%- endcomment -%}
<style>
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  :root {
    /* CI-Palette */
    --bg: {{ settings.color_offwhite }};
    --bg-rgb: {{ settings.color_offwhite | color_extract: 'red' }}, {{ settings.color_offwhite | color_extract: 'green' }}, {{ settings.color_offwhite | color_extract: 'blue' }};
    --surface: {{ settings.color_crema }};
    --text: {{ settings.color_espresso }};
    --text-rgb: {{ settings.color_espresso | color_extract: 'red' }}, {{ settings.color_espresso | color_extract: 'green' }}, {{ settings.color_espresso | color_extract: 'blue' }};
    --muted: {{ settings.color_grau }};
    --accent: {{ settings.color_kupfer }};
    --accent-rgb: {{ settings.color_kupfer | color_extract: 'red' }}, {{ settings.color_kupfer | color_extract: 'green' }}, {{ settings.color_kupfer | color_extract: 'blue' }};
    --accent-dark: {{ settings.color_kupfer | color_darken: 10 }};
    --accent-text: {{ settings.color_offwhite }};
    --dark: {{ settings.color_espresso_deep }};
    --dark-rgb: {{ settings.color_espresso_deep | color_extract: 'red' }}, {{ settings.color_espresso_deep | color_extract: 'green' }}, {{ settings.color_espresso_deep | color_extract: 'blue' }};
    --on-dark: {{ settings.color_offwhite }};
    --on-dark-rgb: {{ settings.color_offwhite | color_extract: 'red' }}, {{ settings.color_offwhite | color_extract: 'green' }}, {{ settings.color_offwhite | color_extract: 'blue' }};
    --on-dark-2: rgba(var(--on-dark-rgb), .72);
    --logo: {{ settings.color_logo | default: '#FFFFFF' }};

    /* Linien & Flächen */
    --line: rgba(var(--text-rgb), .12);
    --line-strong: rgba(var(--text-rgb), .25);
    --line-dark: rgba(var(--on-dark-rgb), .18);

    /* Typografie */
    --f-heading: 'Space Grotesk', system-ui, sans-serif;
    --f-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --fs-h1: clamp(1.875rem, 1.5rem + 1.6vw, 2.5rem);
    --fs-h2: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    --fs-h3: clamp(1.125rem, 1.05rem + .3vw, 1.25rem);
    --fs-body: 1rem;
    --fs-small: .875rem;
    --fs-label: .75rem;
    --ls-label: .09em;

    /* Form & Abstände */
    --radius: {{ settings.card_radius }}px;
    --container: {{ settings.page_width }}px;
    --space: clamp(2.5rem, 5vw, 4rem);
    --space-sm: clamp(1.5rem, 3vw, 2.25rem);
    --ease: cubic-bezier(.2, .65, .3, 1);
  }
</style>

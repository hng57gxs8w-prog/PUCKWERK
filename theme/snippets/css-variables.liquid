{%- comment -%}
  PUCKWERK „Morgenlicht“ – Design-Tokens aus der CI-Palette.
  Schriften lokal im Theme: Space Grotesk (c) The Space Grotesk Project Authors,
  Inter (c) The Inter Project Authors – SIL Open Font License 1.1 (https://openfontlicense.org).
{%- endcomment -%}
{%- liquid
  assign ink = settings.color_espresso
  assign cream = settings.color_crema
  assign copper = settings.color_kupfer
  assign paper = settings.color_offwhite
  assign frame = settings.color_espresso_deep
-%}
<style>
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  :root {
    /* CI-Palette */
    --frame: {{ frame }};
    --frame-rgb: {{ frame | color_extract: 'red' }}, {{ frame | color_extract: 'green' }}, {{ frame | color_extract: 'blue' }};
    --ink: {{ ink }};
    --ink-rgb: {{ ink | color_extract: 'red' }}, {{ ink | color_extract: 'green' }}, {{ ink | color_extract: 'blue' }};
    --paper: {{ paper }};
    --paper-rgb: {{ paper | color_extract: 'red' }}, {{ paper | color_extract: 'green' }}, {{ paper | color_extract: 'blue' }};
    --cream: {{ cream }};
    --cream-rgb: {{ cream | color_extract: 'red' }}, {{ cream | color_extract: 'green' }}, {{ cream | color_extract: 'blue' }};
    --copper: {{ copper }};
    --copper-rgb: {{ copper | color_extract: 'red' }}, {{ copper | color_extract: 'green' }}, {{ copper | color_extract: 'blue' }};
    --copper-deep: {{ copper | color_darken: 10 }};
    --stone: {{ settings.color_grau }};

    /* Rollen */
    --text: var(--ink);
    --text-2: rgba(var(--ink-rgb), .74);
    --line: rgba(var(--ink-rgb), .12);
    --line-strong: rgba(var(--ink-rgb), .24);
    --on-dark: var(--paper);
    --on-dark-2: rgba(var(--paper-rgb), .72);
    --line-dark: rgba(var(--paper-rgb), .14);
    --accent-soft: color-mix(in srgb, var(--copper) 62%, var(--cream));
    --accent-ink: color-mix(in srgb, var(--copper) 78%, var(--ink));

    /* Typografie – CI: Space Grotesk / Inter */
    --f-heading: 'Space Grotesk', system-ui, sans-serif;
    --f-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --fw-display: {{ settings.display_weight }};
    --fs-display: clamp(2.75rem, 1rem + 5.6vw, 6rem);
    --fs-h1: clamp(2.5rem, 1.6rem + 2.8vw, 3.5rem);
    --fs-h2: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    --fs-h3: clamp(1.25rem, 1.1rem + .5vw, 1.5rem);
    --fs-body: 1.0625rem;
    --fs-small: .875rem;
    --fs-label: .75rem;
    --ls-label: .18em;

    /* Form – Karten, Abstände, Bewegung */
    --radius-card: {{ settings.card_radius }}px;
    --radius: calc({{ settings.card_radius }}px * .72);
    --gap: clamp(6px, 1vw, 12px);
    --page-width: {{ settings.page_width }}px;
    --space-section: clamp(4rem, 8vw, 7rem);
    --ease: cubic-bezier(.22, .61, .36, 1);
    --ease-soft: cubic-bezier(.33, 0, .2, 1);
  }
</style>

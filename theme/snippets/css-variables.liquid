<style>
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  :root {
    /* Farben – CI-Palette */
    --c-bg: {{ settings.color_background }};
    --c-surface: {{ settings.color_surface }};
    --c-text: {{ settings.color_text }};
    --c-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
    --c-muted: {{ settings.color_muted }};
    --c-accent: {{ settings.color_accent }};
    --c-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
    --c-accent-dark: {{ settings.color_accent | color_darken: 8 }};
    --c-on-accent: {{ settings.color_on_accent }};
    --c-dark: {{ settings.color_dark }};
    --c-dark-rgb: {{ settings.color_dark.red }}, {{ settings.color_dark.green }}, {{ settings.color_dark.blue }};
    --c-on-dark: {{ settings.color_on_dark }};
    --c-on-dark-rgb: {{ settings.color_on_dark.red }}, {{ settings.color_on_dark.green }}, {{ settings.color_on_dark.blue }};

    /* Typografie – CI-Hierarchie: H1 56/1.05 · H2 40/1.1 · H3 24/1.2 · Body 17/1.65 · Klein 14 · Label 12 */
    --f-heading: 'Space Grotesk', system-ui, sans-serif;
    --f-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --fs-h1: clamp(2.5rem, 1.6rem + 2.8vw, 3.5rem);
    --fs-h2: clamp(2rem, 1.5rem + 1.6vw, 2.5rem);
    --fs-h3: clamp(1.25rem, 1.1rem + .5vw, 1.5rem);
    --fs-body: 1.0625rem;
    --fs-small: .875rem;
    --fs-label: .75rem;
    --ls-label: .18em;

    /* Gestaltung – 8er-Raster, Ecken 20 px, Linien 1 px Kupfer */
    --radius: {{ settings.corner_radius }}px;
    --page-width: {{ settings.page_width }}px;
    --space-section: clamp(4rem, 8vw, 7.5rem);
    --line: 1px solid var(--c-accent);
  }
</style>

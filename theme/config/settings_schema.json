[
  {
    "name": "theme_info",
    "theme_name": "PUCKWERK",
    "theme_version": "2.0.0",
    "theme_author": "PUCKWERK",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Farbmodus",
        "options": [
          {
            "value": "dark",
            "label": "Dunkel – modern (Espresso)"
          },
          {
            "value": "light",
            "label": "Hell – klassisch (Off-White)"
          }
        ],
        "default": "dark"
      },
      {
        "type": "paragraph",
        "content": "Die Farben unten sind die PUCKWERK-CI-Palette. Der Farbmodus verteilt sie automatisch auf Hintergrund, Flächen, Text und Akzente."
      },
      {
        "type": "header",
        "content": "CI-Palette"
      },
      {
        "type": "color",
        "id": "color_espresso",
        "label": "Espresso-Braun (Hauptfarbe)",
        "default": "#2B1D16"
      },
      {
        "type": "color",
        "id": "color_crema",
        "label": "Crema-Beige",
        "default": "#F3E9DC"
      },
      {
        "type": "color",
        "id": "color_kupfer",
        "label": "Kupfer (Akzent, Buttons)",
        "default": "#B87333"
      },
      {
        "type": "color",
        "id": "color_grau",
        "label": "Warmes Grau (Nebentext)",
        "default": "#8A817C"
      },
      {
        "type": "color",
        "id": "color_offwhite",
        "label": "Off-White",
        "default": "#FBF8F4"
      },
      {
        "type": "header",
        "content": "Dunkle Stufen (aus Espresso abgeleitet)"
      },
      {
        "type": "color",
        "id": "color_espresso_deep",
        "label": "Espresso tief – Seitenhintergrund im dunklen Modus",
        "default": "#17100C"
      },
      {
        "type": "color",
        "id": "color_espresso_light",
        "label": "Espresso hell – Eingabefelder, Hover",
        "default": "#3A2A21"
      },
      {
        "type": "header",
        "content": "Effekte"
      },
      {
        "type": "checkbox",
        "id": "grain",
        "label": "Feine Körnung über der Seite (Film-Look)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Inhalte beim Scrollen sanft einblenden",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Eckenradius Karten & Bilder",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Seitenbreite",
        "min": 1040,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "default": 1280
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Wird auf 64 x 64 px skaliert"
      }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Bildformat",
        "options": [
          {
            "value": "square",
            "label": "Quadratisch"
          },
          {
            "value": "portrait",
            "label": "Hochformat"
          },
          {
            "value": "natural",
            "label": "Original"
          }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Zweites Bild beim Hover zeigen",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_type",
        "label": "Produkttyp unter dem Namen zeigen",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Hersteller anzeigen",
        "info": "Bei reinen PUCKWERK-Produkten nicht nötig.",
        "default": false
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram-URL",
        "default": "https://instagram.com/puckwerk"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok-URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube-URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook-URL"
      }
    ]
  }
]
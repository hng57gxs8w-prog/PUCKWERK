[
  {
    "name": "theme_info",
    "theme_name": "PUCKWERK",
    "theme_version": "1.0.0",
    "theme_author": "PUCKWERK",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Farben",
    "settings": [
      { "type": "header", "content": "Grundfarben" },
      { "type": "color", "id": "color_background", "label": "Hintergrund (Eis)", "default": "#F2F5F8" },
      { "type": "color", "id": "color_surface", "label": "Flächen / Karten", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#0A0D12" },
      { "type": "header", "content": "Dunkle Bereiche" },
      { "type": "color", "id": "color_dark", "label": "Dunkel (Header, Footer, Hero)", "default": "#0A0D12" },
      { "type": "color", "id": "color_on_dark", "label": "Text auf Dunkel", "default": "#FFFFFF" },
      { "type": "header", "content": "Akzent" },
      { "type": "color", "id": "color_accent", "label": "Akzentfarbe (Eisblau)", "default": "#00A3FF" },
      { "type": "color", "id": "color_on_accent", "label": "Text auf Akzent", "default": "#0A0D12" },
      { "type": "color", "id": "color_sale", "label": "Sale / Hinweise", "default": "#FF3B1F" }
    ]
  },
  {
    "name": "Typografie & Layout",
    "settings": [
      {
        "type": "select",
        "id": "heading_font",
        "label": "Überschriften-Schrift",
        "options": [
          { "value": "condensed", "label": "Barlow Condensed (sportlich, schmal)" },
          { "value": "inter", "label": "Inter (modern, breit)" }
        ],
        "default": "condensed"
      },
      { "type": "checkbox", "id": "heading_italic", "label": "Überschriften kursiv (Speed-Look)", "default": true },
      { "type": "range", "id": "corner_radius", "label": "Eckenradius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 0 },
      { "type": "range", "id": "page_width", "label": "Seitenbreite", "min": 1000, "max": 1600, "step": 50, "unit": "px", "default": 1400 }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Wird auf 64 x 64 px skaliert" }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      { "type": "checkbox", "id": "card_show_vendor", "label": "Hersteller anzeigen", "default": true },
      { "type": "checkbox", "id": "card_hover_image", "label": "Zweites Bild beim Hover zeigen", "default": true },
      { "type": "select", "id": "card_ratio", "label": "Bildformat", "options": [
        { "value": "square", "label": "Quadratisch" },
        { "value": "portrait", "label": "Hochformat" },
        { "value": "natural", "label": "Original" }
      ], "default": "square" }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram-URL", "default": "https://instagram.com/" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok-URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube-URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook-URL" }
    ]
  }
]

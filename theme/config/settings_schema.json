[
  {
    "name": "theme_info",
    "theme_name": "PUCKWERK",
    "theme_version": "1.0.0",
    "theme_author": "PUCKWERK",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "paragraph",
        "content": "Standardwerte entsprechen dem PUCKWERK Corporate Design."
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Grundfläche (Off-White)",
        "default": "#FBF8F4"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Flächen / Karten (Crema-Beige)",
        "default": "#F3E9DC"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text & Logo (Espresso-Braun)",
        "default": "#2B1D16"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Nebentext (Warmes Grau)",
        "default": "#8A817C"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Akzent & Buttons (Kupfer)",
        "default": "#B87333"
      },
      {
        "type": "color",
        "id": "color_on_accent",
        "label": "Text auf Kupfer",
        "default": "#FBF8F4"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dunkle Bereiche (Espresso)",
        "default": "#2B1D16"
      },
      {
        "type": "color",
        "id": "color_on_dark",
        "label": "Text auf Dunkel",
        "default": "#FBF8F4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Eckenradius Karten & Bilder",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Seitenbreite",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1280
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Wird auf 64 x 64 px skaliert"
      }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Hersteller anzeigen",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Zweites Bild beim Hover zeigen",
        "default": true
      },
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Bildformat",
        "options": [
          {
            "value": "square",
            "label": "Quadratisch"
          },
          {
            "value": "portrait",
            "label": "Hochformat"
          },
          {
            "value": "natural",
            "label": "Original"
          }
        ],
        "default": "square"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram-URL",
        "default": "https://instagram.com/puckwerk"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok-URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube-URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook-URL"
      }
    ]
  }
]
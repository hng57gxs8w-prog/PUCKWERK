<section class="section-pad">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ routes.collections_url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.label | default: c.title
          assign n = forloop.index0 | modulo: 6 | plus: 1
        -%}
        <a href="{{ c.url | default: routes.collections_url }}" class="cat" {{ block.shopify_attributes }}>
          <span class="cat__img">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 22vw, 45vw' }}
            {%- else -%}
              {{ 'collection-' | append: n | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </span>
          <span class="cat__title">{{ label }}</span>
          {%- if c.products_count -%}<span class="cat__count">{{ c.products_count }} Produkte</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien",
  "class": "section-cats",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Kategorien" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde dein Werkzeug" },
    { "type": "text", "id": "link_label", "label": "Link-Text (alle Kategorien)", "default": "Alle Kategorien" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kategorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)", "info": "Leer = Kollektionsbild oder neutrales Platzhalter-Symbol" },
        { "type": "text", "id": "label", "label": "Titel (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorien",
      "blocks": [
        { "type": "tile", "settings": { "label": "Tamper" } },
        { "type": "tile", "settings": { "label": "Verteiler" } },
        { "type": "tile", "settings": { "label": "Tassen" } },
        { "type": "tile", "settings": { "label": "Stationen" } }
      ]
    }
  ]
}
{% endschema %}

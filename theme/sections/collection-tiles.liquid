<section class="section-pad bento">
  <div class="container">
    <div class="sec-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="eyebrow">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ routes.collections_url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="bento__grid bento__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.label | default: c.title
          assign mood_index = forloop.index0 | modulo: 4
          assign moods = 'tamp,grounds,crema,wood' | split: ','
        -%}
        <a href="{{ c.url | default: routes.collections_url }}" class="bento__tile" {{ block.shopify_attributes }}>
          <span class="bento__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
            {%- else -%}
              <span class="mood mood--{{ moods[mood_index] }}"></span>
            {%- endif -%}
          </span>
          <span class="bento__label">
            <span>
              <span class="bento__title">{{ label }}</span>
              {%- if block.settings.text != blank -%}<span class="bento__text">{{ block.settings.text }}</span>{%- endif -%}
            </span>
            <span class="bento__arrow">{% render 'icon', name: 'arrow' %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien (Kacheln)",
  "class": "section-bento",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Kategorien" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde dein Werkzeug" },
    { "type": "text", "id": "link_label", "label": "Link-Text (alle Kategorien)", "default": "Alle Kategorien" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
        { "type": "text", "id": "label", "label": "Titel (optional)" },
        { "type": "text", "id": "text", "label": "Kurztext (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorien (Kacheln)",
      "blocks": [
        { "type": "tile", "settings": { "label": "Tamper", "text": "Plan und gleichmäßig" } },
        { "type": "tile", "settings": { "label": "Verteiler", "text": "Keine Klümpchen mehr" } },
        { "type": "tile", "settings": { "label": "Tassen", "text": "Für die Crema" } },
        { "type": "tile", "settings": { "label": "Stationen", "text": "Ordnung am Morgen" } }
      ]
    }
  ]
}
{% endschema %}

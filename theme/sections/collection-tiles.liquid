<section class="section-pad cats">
  <div class="container">
    {%- if section.settings.heading != blank -%}<p class="divider"><span>{{ section.settings.heading }}</span></p>{%- endif -%}
    <div class="cats__grid" style="--cols: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.label | default: c.title
          assign mood_index = forloop.index0 | modulo: 4
          assign moods = 'tamp,grounds,crema,wood' | split: ','
        -%}
        <a href="{{ c.url | default: routes.collections_url }}" class="cat" {{ block.shopify_attributes }}>
          <span class="cat__img">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 990px) 22vw, 45vw' }}
            {%- else -%}
              <span class="mood mood--{{ moods[mood_index] }}"></span>
            {%- endif -%}
          </span>
          <span class="cat__title">{{ label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien (rund)",
  "class": "section-cats",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Trenner-Text", "default": "Kategorien" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kategorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
        { "type": "text", "id": "label", "label": "Titel (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorien (rund)",
      "blocks": [
        { "type": "tile", "settings": { "label": "Tamper" } },
        { "type": "tile", "settings": { "label": "Verteiler" } },
        { "type": "tile", "settings": { "label": "Tassen" } },
        { "type": "tile", "settings": { "label": "Tamping-Stationen" } }
      ]
    }
  ]
}
{% endschema %}

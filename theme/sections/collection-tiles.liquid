<section class="section-pad tiles">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <div>
          {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="tiles__grid tiles__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.label | default: c.title
        -%}
        <a href="{{ c.url | default: routes.collections_url }}" class="tile" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', class: 'tile__img' }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'tile__img placeholder' }}
          {%- endif -%}
          <span class="tile__label">
            <span class="tile__num">0{{ forloop.index }}</span>
            <span class="tile__title">{{ label }}</span>
            {% render 'icon', name: 'arrow' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorie-Kacheln",
  "class": "section-tiles",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Kategorien" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde dein Setup" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
        { "type": "text", "id": "label", "label": "Titel (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorie-Kacheln",
      "blocks": [
        { "type": "tile", "settings": { "label": "Schläger" } },
        { "type": "tile", "settings": { "label": "Schlittschuhe" } },
        { "type": "tile", "settings": { "label": "Schutz" } }
      ]
    }
  ]
}
{% endschema %}

{%- assign knowledge_url = blogs['werkwissen'].url | default: routes.all_products_collection_url -%}
<section class="section-pad richtext richtext--{{ section.settings.style }}">
  <div class="container container--narrow richtext__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'kicker' -%}<p class="kicker" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}<h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link | default: knowledge_url }}" class="btn btn--accent" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Text-Statement",
  "class": "section-richtext",
  "settings": [
    { "type": "select", "id": "style", "label": "Hintergrund", "options": [
      { "value": "plain", "label": "Ohne Fläche (Off-White)" },
      { "value": "light", "label": "Fläche (Crema)" },
      { "value": "dark", "label": "Dunkel (Espresso)" }
    ], "default": "plain" }
  ],
  "blocks": [
    { "type": "kicker", "name": "Dachzeile", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Unser Versprechen" } ] },
    { "type": "heading", "name": "Überschrift", "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kein Zauber. Nur gutes Werkzeug und ein bisschen Übung." }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ein gleichmäßiger Puck ist die halbe Miete. Wir zeigen dir, wie – kurz, ehrlich, ohne Fachchinesisch.</p>" } ] },
    { "type": "button", "name": "Button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Text", "default": "Zum Shop" },
      { "type": "url", "id": "link", "label": "Link", "info": "Leer = Blog „werkwissen“" }
    ] }
  ],
  "presets": [
    { "name": "Text-Statement", "blocks": [ { "type": "kicker" }, { "type": "heading" }, { "type": "text" } ] }
  ]
}
{% endschema %}

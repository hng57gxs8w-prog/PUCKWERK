<section class="section-pad newsletter">
  <div class="container newsletter__box">
    <div class="newsletter__copy">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    {%- form 'customer', id: 'NewsletterSection', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success">Danke! Check dein Postfach.</p>
      {%- else -%}
        <div class="newsletter-form__row newsletter-form__row--lg">
          <label for="NewsletterEmail" class="visually-hidden">E-Mail</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="Deine E-Mail-Adresse" autocomplete="email">
          <button type="submit" class="btn btn--accent">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ein Tipp pro Monat. Für bessere Shots." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Werkwissen, neue Werkzeuge und nichts, was du nicht lesen willst. Abmelden geht jederzeit.</p>" },
    { "type": "text", "id": "button", "label": "Button-Text", "default": "Anmelden" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}

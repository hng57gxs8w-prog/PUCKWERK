<section class="section-pad">
  <div class="container">
    <h1 class="display">Suche</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
      <label for="SearchPage" class="visually-hidden">Suchbegriff</label>
      <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Wonach suchst du?">
      <button type="submit" class="btn btn--accent">Suchen</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="kicker search__count">{{ search.results_count }} Ergebnisse für „{{ search.terms | escape }}“</p>
        {%- if search.results_count > 0 -%}
          <div class="grid grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <article class="card card--text">
                  <p class="card__vendor">{% if item.object_type == 'article' %}Blog{% else %}Seite{% endif %}</p>
                  <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty"><p class="h3">Nichts gefunden. Versuch’s mit einem anderen Begriff.</p></div>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Seiten">{{ paginate | default_pagination: next: '›', previous: '‹' }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Suche", "class": "section-main-search" }
{% endschema %}

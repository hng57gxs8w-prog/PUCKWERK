<section class="recs" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container section-pad">
      <div class="section-head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
      <div class="grid grid--4">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Produktempfehlungen",
  "class": "section-recs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Passt dazu" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}

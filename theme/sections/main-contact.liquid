<section class="section-pad">
  <div class="container container--narrow">
    <h1 class="display">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">Danke für deine Nachricht! Wir melden uns schnellstmöglich.</p>
      {%- elsif form.errors -%}
        <div class="form-error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form__row">
        <div class="field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></div>
        <div class="field"><label for="ContactEmail">E-Mail *</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email"></div>
      </div>
      <div class="field"><label for="ContactPhone">Telefon</label><input id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
      <div class="field"><label for="ContactBody">Nachricht</label><textarea id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
      <button type="submit" class="btn btn--accent">Senden {% render 'icon', name: 'arrow' %}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Kontaktformular", "class": "section-main-contact" }
{% endschema %}

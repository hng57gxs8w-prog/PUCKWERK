<section class="section-pad">
  <div class="container">
    <h1 class="display">Kategorien</h1>
    <div class="tiles__grid tiles__grid--3">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a href="{{ collection.url }}" class="tile">
          {%- assign img = collection.featured_image -%}
          {%- if img -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', class: 'tile__img' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'tile__img placeholder' }}
          {%- endif -%}
          <span class="tile__label">
            <span class="tile__num">{{ collection.products_count }}</span>
            <span class="tile__title">{{ collection.title }}</span>
            {% render 'icon', name: 'arrow' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Alle Kategorien", "class": "section-list-collections" }
{% endschema %}

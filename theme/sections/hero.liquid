{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section class="hero{% if has_image %} hero--split{% endif %}{% if section.settings.image_position == 'left' %} hero--reverse{% endif %}">
  {%- unless has_image -%}<div class="hero__rings" aria-hidden="true"><span></span><span></span><span></span></div>{%- endunless -%}
  <div class="container hero__grid">
    <div class="hero__content">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--accent">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: routes.collections_url }}" class="btn btn--outline">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if has_image -%}
      <div class="hero__media">
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', class: 'hero__img' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Werkzeug für Home-Baristas" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Espresso. Endlich so gut wie im Café." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Präzises Siebträger-Zubehör aus Edelstahl, Holz und Kupfer. Gemacht für jeden Morgen.</p>" },
    { "type": "text", "id": "button_label", "label": "Button 1 Text", "default": "Zum Shop" },
    { "type": "url", "id": "button_link", "label": "Button 1 Link", "info": "Leer = alle Produkte" },
    { "type": "text", "id": "button2_label", "label": "Button 2 Text" },
    { "type": "url", "id": "button2_link", "label": "Button 2 Link" },
    { "type": "header", "content": "Bild (optional)" },
    { "type": "paragraph", "content": "Ohne Bild erscheint ein schlichtes Textfeld. Nur ein echtes Produktfoto einsetzen." },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "select", "id": "image_position", "label": "Bildposition", "options": [
      { "value": "right", "label": "Rechts" }, { "value": "left", "label": "Links" }
    ], "default": "right" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}

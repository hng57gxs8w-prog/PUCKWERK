{%- liquid
  assign knowledge_url = blogs['werkwissen'].url | default: routes.collections_url
  assign words = section.settings.heading | split: ' '
  assign accent_words = section.settings.heading_accent | split: ' '
  assign word_count = words.size
  assign light = section.settings.light_strength | divided_by: 100.0
  assign overlay = section.settings.overlay | divided_by: 100.0
  assign values = section.settings.values | split: '·'
-%}
<section class="hero{% if section.settings.image != blank %} hero--photo{% endif %}" style="--light: {{ light }}; --overlay: {{ overlay }};" data-hero>
  {%- if section.settings.image != blank -%}
    <div class="hero__photo" aria-hidden="true">
      {{ section.settings.image | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2800', sizes: '100vw', alt: '' }}
    </div>
  {%- endif -%}
  <div class="hero__light" aria-hidden="true">
    <span class="hl hl--1"></span>
    <span class="hl hl--2"></span>
    <span class="hl hl--3"></span>
    <span class="hl hl--beam"></span>
  </div>

  <div class="hero__inner">
    {%- if section.settings.pill_text != blank -%}
      <a class="hero__pill" href="{{ section.settings.pill_link | default: routes.all_products_collection_url }}">
        <span class="hero__dot" aria-hidden="true"></span>{{ section.settings.pill_text }}{% render 'icon', name: 'arrow' %}
      </a>
    {%- endif -%}
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h1 class="hero__title">
        {%- for word in words -%}
          <span class="hero__w" style="--i: {{ forloop.index0 }};">{{ word }}</span>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
        {%- if section.settings.heading_accent != blank -%}
          <span class="hero__accent">
            {%- for word in accent_words -%}
              <span class="hero__w" style="--i: {{ forloop.index0 | plus: word_count }};">{{ word }}</span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="btn-row hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--accent btn--icon">{{ section.settings.button_label }}<span class="btn__icon">{% render 'icon', name: 'arrow' %}</span></a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link | default: knowledge_url }}" class="btn btn--ghost-light">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="hero__foot">
    {%- if values.size > 0 and section.settings.values != blank -%}
      <ul class="hero__values">
        {%- for v in values -%}<li>{{ v | strip }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.show_scroll -%}
      <button type="button" class="hero__scroll" data-scroll-next aria-label="Weiter nach unten scrollen"><span></span></button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero „Morgenlicht“",
  "class": "section-hero",
  "settings": [
    { "type": "paragraph", "content": "Weiches, warmes Licht wandert langsam über den dunklen Grund – wie Morgensonne auf einer Wand." },
    { "type": "range", "id": "light_strength", "label": "Stärke des Lichts", "min": 20, "max": 100, "step": 10, "unit": "%", "default": 70 },
    { "type": "image_picker", "id": "image", "label": "Foto (optional)", "info": "Ersetzt die Lichtstimmung durch ein Foto im CI-Bildstil; das Licht liegt dann weich darüber." },
    { "type": "range", "id": "overlay", "label": "Abdunklung über dem Foto", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Inhalt" },
    { "type": "text", "id": "pill_text", "label": "Plakette über der Überschrift", "default": "Neu im Werk: Tamper 58,5" },
    { "type": "url", "id": "pill_link", "label": "Plakette – Link" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Espresso." },
    { "type": "text", "id": "heading_accent", "label": "Überschrift – Fortsetzung (Kupferton)", "default": "Endlich so gut wie im Café." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Präzises Siebträger-Zubehör aus Edelstahl, Holz und Kupfer. Gemacht für jeden Morgen.</p>" },
    { "type": "text", "id": "button_label", "label": "Button 1 Text", "default": "Zum Shop" },
    { "type": "url", "id": "button_link", "label": "Button 1 Link", "info": "Leer = alle Produkte" },
    { "type": "text", "id": "button2_label", "label": "Button 2 Text", "default": "Werkwissen" },
    { "type": "url", "id": "button2_link", "label": "Button 2 Link", "info": "Leer = Blog mit dem Handle „werkwissen“" },
    { "type": "text", "id": "values", "label": "Werte unten (mit · trennen)", "default": "Präzision · Ehrlichkeit · Handwerk" },
    { "type": "checkbox", "id": "show_scroll", "label": "Scroll-Hinweis anzeigen", "default": true }
  ],
  "presets": [ { "name": "Hero „Morgenlicht“" } ]
}
{% endschema %}

{%- liquid
  assign collection = section.settings.collection
  if collection == blank or collection.products_count == 0
    assign collection = collections['all']
  endif
  assign has_products = false
  if collection.products_count > 0
    assign has_products = true
  endif
-%}
<section class="section-pad featured">
  <div class="container">
    {%- if section.settings.heading_style == 'divider' -%}
      <div class="divider-row">
        <p class="divider"><span>{{ section.settings.kicker }}</span></p>
        {%- if section.settings.show_link -%}
          <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="link-arrow">Alle ansehen {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="section-head">
        <div>
          {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.show_link -%}
          <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="link-arrow">Alle ansehen {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if has_products -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          {% render 'placeholder-product', index: i %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkte",
  "class": "section-featured",
  "settings": [
    { "type": "select", "id": "heading_style", "label": "Kopfzeile", "options": [
      { "value": "divider", "label": "Kupferlinie mit Label (wie CI-Shop)" },
      { "value": "heading", "label": "Dachzeile + Überschrift" }
    ], "default": "divider" },
    { "type": "text", "id": "kicker", "label": "Label / Dachzeile", "default": "Beliebt im Werk" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Werkzeug für jeden Morgen", "info": "Nur bei „Dachzeile + Überschrift“" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = neueste Produkte aus dem ganzen Shop" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Spalten (Desktop)", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "4" },
    { "type": "checkbox", "id": "show_link", "label": "„Alle ansehen“-Link anzeigen", "default": true }
  ],
  "presets": [ { "name": "Produkte" } ]
}
{% endschema %}

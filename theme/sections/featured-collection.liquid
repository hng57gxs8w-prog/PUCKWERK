{%- liquid
  assign collection = section.settings.collection
  if collection == blank or collection.products_count == 0
    assign collection = collections['all']
  endif
  assign has_products = false
  if collection.products_count > 0
    assign has_products = true
  endif
-%}
<section class="section-pad products" data-slider>
  <div class="container">
    <div class="sec-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="eyebrow">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="sec-head__side">
        {%- if section.settings.show_link -%}
          <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="link-arrow">Alle ansehen {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        <div class="slider-nav" role="group" aria-label="Produkte blättern">
          <button type="button" class="round-btn round-btn--prev" data-slider-prev aria-label="Zurück">{% render 'icon', name: 'arrow' %}</button>
          <button type="button" class="round-btn" data-slider-next aria-label="Weiter">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
    </div>
  </div>
  <div class="products__track" data-slider-track>
    {%- if has_products -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <div class="products__slide">{% render 'product-card', product: product %}</div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <div class="products__slide">{% render 'placeholder-product', index: i %}</div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produkte (Reihe)",
  "class": "section-products",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Beliebt im Werk" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Werkzeug für jeden Morgen" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = neueste Produkte aus dem ganzen Shop" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_link", "label": "„Alle ansehen“-Link anzeigen", "default": true }
  ],
  "presets": [ { "name": "Produkte (Reihe)" } ]
}
{% endschema %}

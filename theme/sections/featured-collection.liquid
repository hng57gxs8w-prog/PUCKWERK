{%- assign collection = section.settings.collection -%}
<section class="section-pad featured{% if section.settings.dark %} is-dark{% endif %}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if section.settings.show_link -%}
        <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="link-arrow">Alle ansehen {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          {% render 'product-card', product: nil %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ausgewählte Kollektion",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Bestseller" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was gerade aufs Eis geht" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Spalten (Desktop)", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "checkbox", "id": "show_link", "label": "„Alle ansehen“-Link anzeigen", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dunkler Hintergrund", "default": false }
  ],
  "presets": [ { "name": "Ausgewählte Kollektion" } ]
}
{% endschema %}

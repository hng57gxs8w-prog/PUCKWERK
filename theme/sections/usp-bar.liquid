<section class="usp section-pad-sm">
  <div class="container usp__grid" style="--cols: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      <div class="usp__item" {{ block.shopify_attributes }}>
        <span class="usp__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div>
          <p class="usp__title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}<p class="usp__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Vorteile",
  "class": "section-usp",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "usp",
      "name": "Vorteil",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Versand" }, { "value": "return", "label": "Rückgabe" },
          { "value": "shield", "label": "Sicherheit" }, { "value": "puck", "label": "Puck" },
          { "value": "stick", "label": "Schläger" }, { "value": "bolt", "label": "Blitz" }, { "value": "chat", "label": "Beratung" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Schneller Versand" },
        { "type": "text", "id": "text", "label": "Text", "default": "In 1–3 Werktagen bei dir" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vorteile",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Schneller Versand", "text": "In 1–3 Werktagen bei dir" } },
        { "type": "usp", "settings": { "icon": "return", "title": "30 Tage Rückgabe", "text": "Passt nicht? Kein Problem." } },
        { "type": "usp", "settings": { "icon": "chat", "title": "Profi-Beratung", "text": "Von Spielern für Spieler" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Sicher bezahlen", "text": "SSL & alle gängigen Zahlarten" } }
      ]
    }
  ]
}
{% endschema %}

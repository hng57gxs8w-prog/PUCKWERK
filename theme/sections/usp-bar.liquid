<section class="usp section-pad-sm">
  <div class="container usp__grid" style="--cols: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      <div class="usp__item" {{ block.shopify_attributes }}>
        <span class="usp__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div>
          <p class="usp__title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}<p class="usp__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Vorteile",
  "class": "section-usp",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "usp",
      "name": "Vorteil",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Versand" }, { "value": "return", "label": "Rückgabe" },
          { "value": "shield", "label": "Sicherheit" }, { "value": "mark", "label": "Puck (Bildzeichen)" },
          { "value": "bean", "label": "Kaffeebohne" }, { "value": "hand", "label": "Präzision" }, { "value": "chat", "label": "Beratung" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Heute bestellt" },
        { "type": "text", "id": "text", "label": "Text", "default": "Morgen unterwegs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vorteile",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Heute bestellt", "text": "Morgen unterwegs" } },
        { "type": "usp", "settings": { "icon": "return", "title": "30 Tage Rückgabe", "text": "Ehrlich ohne Haken" } },
        { "type": "usp", "settings": { "icon": "hand", "title": "Präzise gefertigt", "text": "Auf den Zehntelmillimeter" } },
        { "type": "usp", "settings": { "icon": "chat", "title": "Echte Beratung", "text": "Von Baristas, nicht vom Bot" } }
      ]
    }
  ]
}
{% endschema %}

{%- if section.blocks.size > 0 -%}
<div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }};">
  <div class="announcement__track" data-announcement>
    {%- for block in section.blocks -%}
      <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#17100C" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#F3E9DC" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Nachricht",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Ab 49 € versandkostenfrei" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Ankündigungsleiste", "blocks": [ { "type": "message" } ] }
  ]
}
{% endschema %}

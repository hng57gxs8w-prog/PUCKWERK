<footer class="footer">
  <div class="footer__slash" aria-hidden="true"></div>
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="wordmark wordmark--lg">
        {% render 'icon', name: 'puck' %}
        <span class="wordmark__text"><span class="wordmark__a">{{ section.settings.logo_text_1 }}</span><span class="wordmark__b">{{ section.settings.logo_text_2 }}</span></span>
      </a>
      {%- if section.settings.text != blank -%}<div class="footer__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'social-icons' %}
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'text' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <div class="rte">{{ block.settings.text }}</div>
          {%- when 'newsletter' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-success">Danke! Du bist dabei.</p>
              {%- else -%}
                <div class="newsletter-form__row">
                  <label for="FooterEmail" class="visually-hidden">E-Mail</label>
                  <input id="FooterEmail" type="email" name="contact[email]" required placeholder="Deine E-Mail" autocomplete="email">
                  <button type="submit" class="btn btn--accent" aria-label="Anmelden">{% render 'icon', name: 'arrow' %}</button>
                </div>
                {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
              {%- endif -%}
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="container footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright }}</p>
    {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "logo_text_1", "label": "Logo Teil 1", "default": "PUCK" },
    { "type": "text", "id": "logo_text_2", "label": "Logo Teil 2", "default": "WERK" },
    { "type": "richtext", "id": "text", "label": "Markentext", "default": "<p>Ausrüstung für alle, die das Eis lieben. Geprüft von Spielern, gebaut für das nächste Drittel.</p>" },
    { "type": "text", "id": "copyright", "label": "Copyright-Zusatz", "default": "Alle Rechte vorbehalten." },
    { "type": "checkbox", "id": "show_payment", "label": "Zahlungsarten anzeigen", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menü",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fragen zu Größe oder Flex? Schreib uns – wir antworten innerhalb von 24 Stunden.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Newsletter" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Drops, Restocks und Team-Deals zuerst.</p>" }
      ]
    }
  ]
}
{% endschema %}

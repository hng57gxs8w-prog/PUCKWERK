<section class="section-pad account">
  <div class="container container--xs">
    <h1 class="display">Neues Passwort</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">Passwort</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">Passwort bestätigen</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--accent btn--block">Passwort speichern</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Passwort zurücksetzen", "class": "section-reset" }
{% endschema %}

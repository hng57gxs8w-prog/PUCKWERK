<section class="password">
  <div class="password__inner">
    <span class="wordmark wordmark--xl">
      {% render 'icon', name: 'puck' %}
      <span class="wordmark__text"><span class="wordmark__a">{{ section.settings.logo_text_1 }}</span><span class="wordmark__b">{{ section.settings.logo_text_2 }}</span></span>
    </span>
    <h1 class="display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-success">Wir sagen dir Bescheid, sobald es losgeht!</p>
      {%- else -%}
        <div class="newsletter-form__row newsletter-form__row--lg">
          <label for="PwEmail" class="visually-hidden">E-Mail</label>
          <input id="PwEmail" type="email" name="contact[email]" required placeholder="Deine E-Mail">
          <button type="submit" class="btn btn--accent">Benachrichtigen</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Mit Passwort eintreten</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter-form__row">
          <label for="PwPassword" class="visually-hidden">Passwort</label>
          <input id="PwPassword" type="password" name="password" placeholder="Passwort" autocomplete="current-password">
          <button type="submit" class="btn btn--light">Eintreten</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "logo_text_1", "label": "Logo Teil 1", "default": "PUCK" },
    { "type": "text", "id": "logo_text_2", "label": "Logo Teil 2", "default": "WERK" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bald geht’s aufs Eis." }
  ]
}
{% endschema %}

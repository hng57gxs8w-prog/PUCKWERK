{%- liquid
  assign style = section.settings.style
  assign fallback_url = pages['ueber-uns'].url | default: routes.root_url
  assign btn_class = 'btn--accent'
  if style == 'box' or style == 'dark'
    assign btn_class = 'btn--light'
  endif
-%}
<section class="section-pad iwt iwt--{{ style }}">
  <div class="container">
    <div class="iwt__grid{% if section.settings.image_right %} iwt__grid--image-right{% endif %}">
      <div class="iwt__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'iwt__img' }}
        {%- else -%}
          <span class="iwt__img mood mood--wood" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.badge != blank -%}<span class="iwt__badge">{{ section.settings.badge }}</span>{%- endif -%}
      </div>
      <div class="iwt__content">
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: fallback_url }}" class="btn {{ btn_class }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild mit Text",
  "class": "section-iwt",
  "settings": [
    { "type": "select", "id": "style", "label": "Stil", "options": [
      { "value": "box", "label": "Espresso-Karte, abgerundet" },
      { "value": "dark", "label": "Volle Breite, Espresso-Fläche" },
      { "value": "light", "label": "Volle Breite, ohne Fläche" }
    ], "default": "box" },
    { "type": "image_picker", "id": "image", "label": "Bild", "info": "CI-Bildstil: warmes Seitenlicht, Holz, Stein, Hände." },
    { "type": "checkbox", "id": "image_right", "label": "Bild rechts", "default": true },
    { "type": "text", "id": "badge", "label": "Runder Stempel auf dem Bild (optional)", "info": "Nur verwenden, wenn die Aussage stimmt – z. B. „Made in Germany“." },
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Das Werk" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Präzision, die man in der Hand spürt." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wir testen jedes Werkzeug jeden Morgen selbst. Was nicht besser macht, kommt nicht ins Sortiment.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Über uns" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Leer = Seite mit dem Handle „ueber-uns“" }
  ],
  "presets": [ { "name": "Bild mit Text" } ]
}
{% endschema %}

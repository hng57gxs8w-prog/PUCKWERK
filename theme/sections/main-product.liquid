{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section-pad-sm product" data-product data-money-format="{{ shop.money_format | escape }}">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Brotkrumen">
      <a href="{{ routes.root_url }}">Start</a> /
      {%- if collection -%} <a href="{{ collection.url }}">{{ collection.title }}</a> /{%- endif -%}
      <span>{{ product.title }}</span>
    </nav>
    <div class="product__grid">
      <div class="product__media">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="product__media-item{% if forloop.first %} is-first{% endif %}" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 55vw, 100vw' }}
                {%- else -%}
                  {{ media | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 27vw, 100vw' }}
                {%- endif -%}
              {%- elsif media.media_type == 'external_video' -%}
                {{ media | external_video_tag }}
              {%- elsif media.media_type == 'video' -%}
                {{ media | video_tag: controls: true }}
              {%- else -%}
                {{ media | media_tag }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="product__media-item is-first">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endif -%}
      </div>

      <div class="product__info">
        <div class="product__sticky">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                <p class="kicker" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- when 'title' -%}
                <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
              {%- when 'price' -%}
                <div class="product__price" {{ block.shopify_attributes }}>
                  {% render 'price', product: product, variant: current_variant %}
                  {%- if cart.taxes_included -%}
                    <p class="product__tax">inkl. MwSt.{% if shop.shipping_policy.body != blank %}, zzgl. <a href="{{ shop.shipping_policy.url }}">Versand</a>{% endif %}</p>
                  {%- endif -%}
                </div>
              {%- when 'text' -%}
                <div class="product__note rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- when 'buy' -%}
                <div {{ block.shopify_attributes }}>
                  {%- form 'product', product, id: 'ProductForm', class: 'product-form', novalidate: 'novalidate' -%}
                    {%- unless product.has_only_default_variant -%}
                      {%- for option in product.options_with_values -%}
                        {%- assign opt_index = forloop.index -%}
                        <fieldset class="option" data-option="{{ forloop.index0 }}">
                          <legend class="option__label">{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
                          <div class="option__values">
                            {%- for value in option.values -%}
                              <input type="radio" class="visually-hidden" id="Opt-{{ section.id }}-{{ opt_index }}-{{ forloop.index }}" name="option-{{ opt_index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                              <label class="pill" for="Opt-{{ section.id }}-{{ opt_index }}-{{ forloop.index }}">{{ value }}</label>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endfor -%}
                    {%- endunless -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                    <div class="product-form__row">
                      <div class="qty">
                        <button type="button" class="qty__btn" data-qty="-1" aria-label="Weniger">−</button>
                        <label for="Quantity-{{ section.id }}" class="visually-hidden">Menge</label>
                        <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" class="qty__input">
                        <button type="button" class="qty__btn" data-qty="1" aria-label="Mehr">+</button>
                      </div>
                      <button type="submit" name="add" class="btn btn--accent btn--lg btn--block" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                        <span data-add-label>{% if current_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</span>
                      </button>
                    </div>
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class="product-form__dynamic">{{ form | payment_button }}</div>
                    {%- endif -%}
                  {%- endform -%}
                  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
                </div>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <details class="accordion" open {{ block.shopify_attributes }}>
                    <summary>Beschreibung</summary>
                    <div class="rte">{{ product.description }}</div>
                  </details>
                {%- endif -%}
              {%- when 'collapsible' -%}
                <details class="accordion" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  </div>
                </details>
              {%- when 'usps' -%}
                <ul class="product__usps" {{ block.shopify_attributes }}>
                  <li>{% render 'icon', name: 'truck' %} {{ block.settings.line1 }}</li>
                  <li>{% render 'icon', name: 'return' %} {{ block.settings.line2 }}</li>
                  <li>{% render 'icon', name: 'shield' %} {{ block.settings.line3 }}</li>
                </ul>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produktseite",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Hersteller", "limit": 1 },
    { "type": "title", "name": "Titel", "limit": 1 },
    { "type": "price", "name": "Preis", "limit": 1 },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Lieferzeit: 1–3 Werktage</p>" } ] },
    { "type": "buy", "name": "Varianten & Kaufen", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout-Buttons anzeigen", "default": true }
    ] },
    { "type": "description", "name": "Beschreibung", "limit": 1 },
    { "type": "collapsible", "name": "Aufklappbereich", "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Größenberatung" },
      { "type": "richtext", "id": "content", "label": "Inhalt", "default": "<p>Unsicher bei der Größe? Schreib uns – wir helfen dir beim Fitting.</p>" },
      { "type": "page", "id": "page", "label": "Inhalt aus Seite" }
    ] },
    { "type": "usps", "name": "Vorteile", "limit": 1, "settings": [
      { "type": "text", "id": "line1", "label": "Zeile 1", "default": "Gratis Versand ab 79 €" },
      { "type": "text", "id": "line2", "label": "Zeile 2", "default": "30 Tage Rückgabe" },
      { "type": "text", "id": "line3", "label": "Zeile 3", "default": "Sichere Bezahlung" }
    ] }
  ]
}
{% endschema %}
